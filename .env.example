# URL backend untuk proxy server-side Next.js (/api/* -> backend)
# Wajib di-set saat build (Coolify: Build Variable)
API_PROXY_URL=http://localhost:4626

# Base URL axios di browser. Kosongkan agar request lewat proxy /api (disarankan)
# Wajib di-set saat build jika digunakan (Coolify: Build Variable)
NEXT_PUBLIC_API_URL=
